#Database
host = your_host
db = your_db
user = your_user 
pass = your_pass
port = 3306

#JWT security
secret = your_secret

#File Upload
maxsize = max_upload_file_size_In_octet

#System
debug_mode = true

# SMTP
SMTP_USER = user@example.com
SMTP_PASS = password
FROM_EMAIL = user@example.com
FROM_NAME= Admin
SMTP_HOST = smtp.example.com
SMTP_PORT = 587
MAX_ATTACHMENT = 10 # in Mo

#Logs
# values should be empty. If so, logs are writen in default log file.
ERROR_LOG_PATH = logs/error
WARNING_LOG_PATH = logs/warning
INFO_LOG_PATH = logs/info